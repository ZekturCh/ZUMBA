rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          "CAMBIA-ESTE-CORREO@tudominio.com"
        ];
    }

    match /codes/{code} {
      allow get: if code.matches('^[A-Z0-9]{5}$');
      allow list: if isAdmin();
      allow create: if false;
      allow delete: if false;

      allow update: if (
        isAdmin()
        ||
        (
          resource.data.validated != true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status",
            "guestName",
            "reservedAt"
          ])
          && request.resource.data.status == "reserved"
          && request.resource.data.guestName is string
          && request.resource.data.guestName.size() <= 60
        )
      );
    }
  }
}
